PORT=3000
CORS_ORIGIN=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=geobaches

# Fotos: con S3_BUCKET definido se guardan en un bucket S3-compatible (Railway Bucket).
# Sin S3_BUCKET se guardan en disco local (backend/uploads): solo para desarrollo.
# En Railway, referenciar las variables del servicio Bucket (ej. S3_BUCKET=${{Bucket.BUCKET}}).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true solo si el endpoint exige path-style (MinIO, s3rver)
S3_FORCE_PATH_STYLE=

# Login del panel de revisión (admin/pendientes), validado contra la tabla "usuarios".
# ADMIN_USER/ADMIN_PASSWORD_HASH solo se usan para sembrar ese primer usuario admin al
# arrancar (con rol "admin"), si todavía no existe — no se vuelven a leer después de eso.
# JWT_SECRET: cualquier string largo random, ej. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_PASSWORD_HASH: hash de bcrypt de la contraseña, nunca la contraseña en texto plano.
#   node -e "console.log(require('bcrypt').hashSync('tu-contraseña', 10))"
JWT_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
