# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.
# Monorepo: una regla SIN "/" en el medio (dist/, node_modules/, .angular/) aplica en frontend/ y backend/;
# con "/" en el medio (backend/.env) queda anclada a esa ruta.

# Compiled output
dist/
tmp/
out-tsc/
bazel-out/
coverage/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Backend (secretos y fotos subidas por usuarios: no van al repo)
.env
.env.*
!.env.example
backend/uploads/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
.angular/
.sass-cache/
connect.lock
libpeerconnection.log
testem.log
typings/
__screenshots__/

# System files
.DS_Store
Thumbs.db
